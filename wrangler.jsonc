{
  // Diwilo Modulos: Worker central de los módulos horizontales (Finanzas, Marketing…) para todas las apps.
  // Sin dominio ni workers.dev: solo lo llaman las apps (y Diwilo Web) por service binding con "entrypoint": "Modulos".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diwilo-modulos",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Workers Builds: en cada push a main aplica las migraciones y despliega.
  "build": {
    "command": "sh -c 'if [ -n \"$WORKERS_CI\" ]; then npx wrangler d1 migrations apply diwilo-modulos-db --remote; fi'"
  },
  // Código de las páginas de los módulos (public/m/*): lo piden las apps por RPC (asset), no se publica.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "diwilo-modulos-db", "database_id": "d4969edc-4280-438f-a19d-e5a1ac07c33c", "migrations_dir": "migrations" }
  ],
  // IA del módulo «IA» (chats de clientes, asistente y agentes) e informes de Marketing: Workers AI (gasta la cuota diaria compartida;
  // cada negocio tiene su tope diario en ia_uso). Con el secreto GEMINI_API_KEY usa Gemini y cae a Workers AI si falla.
  "ai": { "binding": "AI" },
  // Mensajes · canal de correo: las respuestas salen por Cloudflare Email Sending (el dominio debe estar activado ahí) y los correos sin bandeja se reenvían al respaldo.
  "send_email": [{ "name": "EMAIL" }],
  "vars": { "CORREO_RESPALDO": "diwilo.tech@gmail.com" },
  // 3:00 a. m. Colombia: gastos recurrentes y automatizaciones de todos los negocios.
  "triggers": { "crons": ["0 8 * * *", "*/2 * * * *"] }
}
